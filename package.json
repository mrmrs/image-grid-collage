{
  "name": "fieldwork-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "preview": "vite preview --host 127.0.0.1",
    "test:browser": "node tests/browser-check.mjs",
    "test:workflow": "node tests/workflow-check.mjs",
    "test:motion": "node tests/motion-check.mjs && node tests/motion-autoplay-check.mjs",
    "deploy": "npm run build && wrangler deploy",
    "deploy:check": "npm run build && wrangler deploy --dry-run"
  },
  "dependencies": {
    "ag-psd": "^29.0.0",
    "dialkit": "^2.0.2",
    "fflate": "^0.8.2",
    "idb-keyval": "^6.2.1",
    "lucide-react": "^0.468.0",
    "motion": "^14.6.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "~5.9.3",
    "utif": "^3.1.0",
    "vite": "^7.1.0",
    "vitest": "^5.0.4",
    "wrangler": "^4.152.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
